{
 "uid": "notes",
 "title": "Notes app",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second by route and status",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route, status) (rate(http_requests_total{namespace=\"notes\"}[1m]))",
     "legendFormat": "{{route}} {{status}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Error ratio (SLO 1%)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "notes:error_ratio:rate5m",
     "legendFormat": "5xx ratio"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "p95 latency by route (SLO 300ms)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{namespace=\"notes\"}[5m])))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "table",
   "title": "Running version per pod",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "notes_build_info{namespace=\"notes\"}",
     "legendFormat": "{{pod}} {{version}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Ready app pods",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up{namespace=\"notes\",service=\"notes-app\"})",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Container restarts",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"notes\"})",
     "legendFormat": "{{pod}}"
    }
   ]
  }
 ]
}